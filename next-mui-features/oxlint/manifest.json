{
  "name": "oxlint",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.67.0",
    "oxlint": "^1.76.0"
  },
  "files": [
    {
      "src": "source/.oxlintignore",
      "dest": ".oxlintignore",
      "root": true
    },
    {
      "src": "source/.oxlintrc.json",
      "dest": ".oxlintrc.json",
      "root": true
    },
    {
      "src": "source/oxfmtrc.json",
      "dest": ".oxfmtrc.json",
      "root": true
    }
  ]
}
